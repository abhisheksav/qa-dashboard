# Postgres 16 connection. docker-compose sets this automatically for the
# containerized API; only needed here if you run the API outside Docker.
DATABASE_URL=postgres://qa_dashboard:qa_dashboard@localhost:5432/qa_dashboard

# Signs session tokens. Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid before the browser must sign in again.
JWT_EXPIRY=7d

PORT=4000

# Comma-separated origins allowed to call this API. Set to the dashboard's
# deployed URL in production — "*" is fine for local dev only.
CORS_ORIGIN=http://localhost:5173
